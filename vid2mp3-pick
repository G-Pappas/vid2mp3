#!/usr/bin/env python3
"""Headless GTK4 multi-file picker for video files. Prints one path per line."""
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk

VIDEO_EXTS = {
    ".webm", ".mp4", ".mkv", ".mov", ".avi", ".flv", ".wmv",
    ".m4v", ".mpg", ".mpeg", ".ts", ".3gp", ".ogv",
}


def main():
    Gtk.init()
    loop = GLib.MainLoop()

    dialog = Gtk.FileDialog(title="Choose videos")
    filt = Gtk.FileFilter()
    filt.set_name("Video files")
    for ext in VIDEO_EXTS:
        filt.add_pattern(f"*{ext}")
    filters = Gio.ListStore.new(Gtk.FileFilter)
    filters.append(filt)
    dialog.set_filters(filters)

    def on_done(dlg, result):
        try:
            files = dlg.open_multiple_finish(result)
            for f in files:
                path = f.get_path()
                if path:
                    print(path)
        except GLib.Error:
            pass
        finally:
            loop.quit()

    dialog.open_multiple(None, None, on_done)
    loop.run()


if __name__ == "__main__":
    main()
