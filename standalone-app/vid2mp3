#!/usr/bin/env python3
"""Simple drag-and-drop video -> MP3 converter (GTK4 + Adwaita, uses ffmpeg)."""
import os
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gio", "2.0")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk

VIDEO_EXTS = {
    ".webm", ".mp4", ".mkv", ".mov", ".avi", ".flv", ".wmv",
    ".m4v", ".mpg", ".mpeg", ".ts", ".3gp", ".ogv",
}

STATUS_QUEUED = "queued"
STATUS_WORKING = "working"
STATUS_DONE = "done"
STATUS_ERROR = "error"


class Row(Gtk.Box):
    def __init__(self, path: Path):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.path = path
        self.status = STATUS_QUEUED
        self.set_margin_top(6)
        self.set_margin_bottom(6)
        self.set_margin_start(12)
        self.set_margin_end(12)

        icon = Gtk.Image.new_from_icon_name("video-x-generic-symbolic")
        self.append(icon)

        label_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
        self.name_label = Gtk.Label(label=path.name, xalign=0)
        self.name_label.set_ellipsize(3)
        self.status_label = Gtk.Label(label="Ready", xalign=0)
        self.status_label.add_css_class("dim-label")
        self.status_label.add_css_class("caption")
        label_box.append(self.name_label)
        label_box.append(self.status_label)
        self.append(label_box)

        self.spinner = Gtk.Spinner()
        self.append(self.spinner)

        self.check_icon = Gtk.Image.new_from_icon_name("emblem-ok-symbolic")
        self.check_icon.add_css_class("success")
        self.check_icon.set_visible(False)
        self.append(self.check_icon)

        self.remove_btn = Gtk.Button(icon_name="user-trash-symbolic")
        self.remove_btn.add_css_class("flat")
        self.append(self.remove_btn)

    def set_working(self):
        self.status = STATUS_WORKING
        self.status_label.set_label("Converting…")
        self.spinner.start()
        self.remove_btn.set_sensitive(False)

    def set_done(self, out_path: Path):
        self.status = STATUS_DONE
        self.spinner.stop()
        self.status_label.set_label(f"Saved as {out_path.name}")
        self.check_icon.set_visible(True)

    def set_error(self, message: str):
        self.status = STATUS_ERROR
        self.spinner.stop()
        self.status_label.set_label(f"Failed: {message}")
        self.status_label.remove_css_class("dim-label")
        self.status_label.add_css_class("error")


class Win(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Video to MP3")
        self.set_default_size(560, 480)
        self.rows: list[Row] = []
        self.converting = False

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar.add_top_bar(header)

        self.add_btn = Gtk.Button(label="Add Videos…")
        self.add_btn.add_css_class("flat")
        self.add_btn.connect("clicked", self.on_add_clicked)
        header.pack_start(self.add_btn)

        self.convert_btn = Gtk.Button(label="Convert to MP3")
        self.convert_btn.add_css_class("suggested-action")
        self.convert_btn.set_sensitive(False)
        self.convert_btn.connect("clicked", self.on_convert_clicked)
        header.pack_end(self.convert_btn)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        self.stack = Gtk.Stack()
        self.stack.set_vexpand(True)

        # Empty state / drop target
        empty = Adw.StatusPage(
            title="Drop video files here",
            description="…or click “Add Videos” above. Supported: MP4, WebM, MKV, MOV, AVI and more.",
            icon_name="folder-videos-symbolic",
        )
        self.stack.add_named(empty, "empty")

        scroller = Gtk.ScrolledWindow(vexpand=True)
        self.listbox = Gtk.ListBox()
        self.listbox.add_css_class("boxed-list")
        self.listbox.set_margin_top(12)
        self.listbox.set_margin_bottom(12)
        self.listbox.set_margin_start(12)
        self.listbox.set_margin_end(12)
        scroller.set_child(self.listbox)
        self.stack.add_named(scroller, "list")

        self.stack.set_visible_child_name("empty")
        outer.append(self.stack)

        self.status_bar = Gtk.Label(label="")
        self.status_bar.add_css_class("dim-label")
        self.status_bar.set_margin_bottom(8)
        outer.append(self.status_bar)

        toolbar.set_content(outer)
        self.set_content(toolbar)

        # Drag and drop onto the whole window
        drop_target = Gtk.DropTarget.new(type=Gdk.FileList, actions=Gdk.DragAction.COPY)
        drop_target.connect("drop", self.on_drop)
        self.add_controller(drop_target)

        self.open_folder_btn = Gtk.Button(label="Open Folder")
        self.open_folder_btn.add_css_class("flat")
        self.open_folder_btn.set_visible(False)
        self.open_folder_btn.connect("clicked", self.on_open_folder_clicked)
        header.pack_end(self.open_folder_btn)
        self._last_out_dir = None

    # -- file management -------------------------------------------------
    def add_paths(self, paths):
        added = 0
        for p in paths:
            path = Path(p)
            if path.is_dir():
                continue
            if path.suffix.lower() not in VIDEO_EXTS:
                continue
            if any(r.path == path for r in self.rows):
                continue
            self.add_row(path)
            added += 1
        if added:
            self.stack.set_visible_child_name("list")
            self.update_status()

    def add_row(self, path: Path):
        row = Row(path)
        row.remove_btn.connect("clicked", lambda b, r=row: self.remove_row(r))
        list_row = Gtk.ListBoxRow(selectable=False)
        list_row.set_child(row)
        row.list_row = list_row
        self.listbox.append(list_row)
        self.rows.append(row)
        self.convert_btn.set_sensitive(True)

    def remove_row(self, row: Row):
        if self.converting:
            return
        self.listbox.remove(row.list_row)
        self.rows.remove(row)
        if not self.rows:
            self.stack.set_visible_child_name("empty")
            self.convert_btn.set_sensitive(False)
        self.update_status()

    def update_status(self, extra: str = ""):
        n = len(self.rows)
        base = f"{n} file{'s' if n != 1 else ''} queued" if n else ""
        self.status_bar.set_label(extra or base)

    # -- UI callbacks ------------------------------------------------------
    def on_add_clicked(self, _btn):
        dialog = Gtk.FileDialog(title="Choose videos")
        filt = Gtk.FileFilter()
        filt.set_name("Video files")
        for ext in VIDEO_EXTS:
            filt.add_pattern(f"*{ext}")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        dialog.set_filters(filters)
        dialog.open_multiple(self, None, self._on_files_chosen)

    def _on_files_chosen(self, dialog, result):
        try:
            files = dialog.open_multiple_finish(result)
        except GLib.Error:
            return
        paths = [f.get_path() for f in files if f.get_path()]
        self.add_paths(paths)

    def on_drop(self, _target, value, _x, _y):
        try:
            paths = [f.get_path() for f in value if f.get_path()]
        except TypeError:
            return False
        self.add_paths(paths)
        return True

    def on_convert_clicked(self, _btn):
        if self.converting or not self.rows:
            return
        self.converting = True
        self.convert_btn.set_sensitive(False)
        self.add_btn.set_sensitive(False)
        for r in self.rows:
            r.remove_btn.set_sensitive(False)
        threading.Thread(target=self.convert_all, daemon=True).start()

    # -- conversion ----------------------------------------------------
    def convert_all(self):
        total = len(self.rows)
        last_output_dir = None
        for i, row in enumerate(self.rows, start=1):
            GLib.idle_add(row.set_working)
            GLib.idle_add(self.update_status, f"Converting {i} of {total}: {row.path.name}")
            out_path = row.path.with_suffix(".mp3")
            try:
                subprocess.run(
                    [
                        "ffmpeg", "-y", "-i", str(row.path),
                        "-vn", "-acodec", "libmp3lame", "-q:a", "2",
                        str(out_path),
                    ],
                    check=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
                last_output_dir = out_path.parent
                GLib.idle_add(row.set_done, out_path)
            except subprocess.CalledProcessError as e:
                msg = e.stderr.decode(errors="replace").strip().splitlines()[-1] if e.stderr else "ffmpeg error"
                GLib.idle_add(row.set_error, msg)
            except FileNotFoundError:
                GLib.idle_add(row.set_error, "ffmpeg not found")
        GLib.idle_add(self.finish_conversion, total, last_output_dir)

    def finish_conversion(self, total, out_dir):
        self.converting = False
        self.convert_btn.set_sensitive(True)
        self.add_btn.set_sensitive(True)
        ok = sum(1 for r in self.rows if r.status == STATUS_DONE)
        self.update_status(f"Done: {ok}/{total} converted successfully.")
        if out_dir:
            self._last_out_dir = out_dir
            self.open_folder_btn.set_visible(True)

    def on_open_folder_clicked(self, _btn):
        if self._last_out_dir:
            Gio.AppInfo.launch_default_for_uri(self._last_out_dir.as_uri(), None)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="com.gpappas.Vid2Mp3")

    def do_activate(self):
        win = self.props.active_window or Win(self)
        win.present()


if __name__ == "__main__":
    import sys
    App().run(sys.argv)
